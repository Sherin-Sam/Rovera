# Local simulation; no paid APIs or keys needed.
APP_MODE=SIMULATION
DATABASE_PATH=./data/drishtinav.db
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Set a long random token before LAN/public use. Enter it in Settings > Connection.
AUTH_TOKEN=
# Default denies ALL writes through forwarded/tunnel requests, even with token.
ENABLE_REMOTE_CONTROL=false
# Optional separate-origin static deployment: set VITE_API_URL at build time.
VITE_API_URL=
